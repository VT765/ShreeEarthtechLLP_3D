# Enquiry form backend. GitHub Pages is static, so the form posts JSON to a hosted form service.
# Copy to `.env.local` for local dev. For the GitHub Pages build, expose the same names to the
# `vite build` step (e.g. repository Variables → `env:` in .github/workflows/deploy-pages.yml).
# NOTE: VITE_* values are compiled into the public JS bundle — never put real secrets here.
#
# If VITE_FORM_ENDPOINT is unset, the form falls back to opening a pre-filled mailto: to the sales inbox.

# --- Option A: Formspree (https://formspree.io) ---------------------------------
# Create a form, then use its endpoint. No access key needed.
# VITE_FORM_ENDPOINT=https://formspree.io/f/xxxxxxxx

# --- Option B: Web3Forms (https://web3forms.com) --------------------------------
# Web3Forms requires an `access_key` field in the body; set it below and the form adds it.
# VITE_FORM_ENDPOINT=https://api.web3forms.com/submit
# VITE_FORM_ACCESS_KEY=your-web3forms-access-key

VITE_FORM_ENDPOINT=
VITE_FORM_ACCESS_KEY=
